# --- Nix Build Artifacts ---
# Created whenever you run 'nix build' manually
result
result-*

# --- Development Shell Caches ---
# Used if you adopt 'direnv' with your devShells
.direnv/
.envrc.local

# --- Python & Qtile Bytecode ---
# Compiled Python cache generated by Qtile or Python scripts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# --- Neovim / Vim Swap & Backup Files ---
# Temporary swap files created while editing in Neovim
*.swp
*.swo
*~
.netrwhist
*.undo

# --- Secret Safety Net ---
# Prevents accidental commits of private keys or unencrypted secret dumps
*.key
*.pem
*.age
id_rsa*
id_ed25519*
!secrets/secrets.yaml  # Explicitly allow your encrypted SOPS secrets file

# --- OS System Files ---
.DS_Store
Thumbs.db
core.*
core
